# ========================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ========================================
# Copy this section to backend/.env file

# Server Configuration
# NODE_ENV=development
# PORT=3000

# Supabase Database
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-secret-key
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# AWS Cognito (Token Verification)
# COGNITO_USER_POOL_ID=us-east-1_lYGQMWQbj
# COGNITO_REGION=us-east-1

# AWS S3 (Media Uploads)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_BUCKET=mallucupid-images

# JWT Secret (Additional verification if needed)
# JWT_SECRET=change-this-to-a-random-secret-string

# CORS Configuration
# CORS_ORIGIN=https://main.d19gr2nqobengq.amplifyapp.com,http://localhost:5173
